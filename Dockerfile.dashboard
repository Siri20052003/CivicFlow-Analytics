FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CIVICFLOW_DB=/home/civicflow/data/civicflow.db

RUN groupadd --system civicflow && useradd --system --gid civicflow --create-home civicflow
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .

RUN mkdir -p /home/civicflow/data && chown civicflow:civicflow /home/civicflow/data
USER civicflow
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3)"
ENTRYPOINT ["streamlit", "run", "src/civicflow/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501"]
